# Use Case 4: Top CVEs by CVSS Score
# Rank CVEs by CVSS 3.x base score to surface the most severe vulnerabilities first.

PREFIX cve: <http://w3id.org/sepses/vocab/ref/cve#>
PREFIX cvss: <http://w3id.org/sepses/vocab/ref/cvss#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?cveId ?score ?severity ?vector WHERE {
  ?cve a cve:CVE ;
       dcterms:identifier ?cveId ;
       cve:hasCVSS3BaseMetric ?metric .

  ?metric cvss:baseScore ?score .
  OPTIONAL { ?metric cvss:baseSeverity ?severity . }
  OPTIONAL { ?metric cvss:vectorString ?vector . }
}
ORDER BY DESC(?score) ?cveId
LIMIT 20
