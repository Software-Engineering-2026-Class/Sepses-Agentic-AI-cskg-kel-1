# Optional NVD API key. Leave empty for unauthenticated NVD requests.
NVD_API_KEY=

# QLever bootstrap behavior.
QLEVER_BOOT_TIMEOUT_SECONDS=600
QLEVER_CHECK_INTERVAL_SECONDS=10
QLEVER_RETRY_AFTER_FAILURE_SECONDS=30
QLEVER_AUTOBUILD=0
QLEVER_AUTO_START=1
QLEVER_CONTAINER_MEMORY=16g
QLEVER_STXXL_MEMORY=AUTO
QLEVER_PARSER_BUFFER_SIZE=AUTO
QLEVER_NUM_THREADS=1
QLEVER_MEMORY_FOR_QUERIES=768M
QLEVER_CACHE_MAX_SIZE=256M
QLEVER_INDEX_OOM_RETRIES=3
QLEVER_MIN_INDEX_MEMORY_BYTES=4294967296

# Custom browser query interface.
QLEVER_ENDPOINT_URL=http://host.docker.internal:7001/sparql
QLEVER_INTERFACE_HOST=0.0.0.0
QLEVER_INTERFACE_PORT=8000
QLEVER_QUERY_TIMEOUT_SECONDS=60
